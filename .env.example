# Copia este fichero a .env.local para desarrollo, y añade las mismas
# variables en Vercel (Project → Settings → Environment Variables) para
# producción. Sin ellas, el formulario de contacto sigue funcionando en el
# navegador, pero /api/contact responde con un error explicando que falta
# configurarlo (no falla en silencio).

# API key de Resend (resend.com → API Keys). Gratis hasta 3000 emails/mes.
RESEND_API_KEY=

# A qué email llegan los mensajes del formulario.
CONTACT_EMAIL_TO=

# Remitente que verá quien reciba el email. Con el dominio de prueba de
# Resend (onboarding@resend.dev) funciona sin verificar nada, pero solo tú
# puedes recibir en esa dirección de prueba: para enviarte a ti mismo real
# está bien, para producción de verdad hay que verificar un dominio propio en
# Resend y poner aquí una dirección de ese dominio (p. ej. contacto@tudominio.com).
CONTACT_EMAIL_FROM=

# URL pública del sitio ya desplegado (para que las imágenes Open Graph y el
# JSON-LD lleven la URL absoluta correcta). Opcional: en Vercel se calcula
# sola a partir del dominio de producción; solo hace falta si usas un dominio
# propio y quieres fijarlo explícitamente.
NEXT_PUBLIC_SITE_URL=

# Pon esto a "true" (y vuelve a desplegar) cuando el sitio esté listo para
# salir en los buscadores. Mientras no exista o valga otra cosa, el sitio se
# sirve con noindex por tres vías: la etiqueta <meta robots> de cada página,
# la cabecera X-Robots-Tag y el Disallow de robots.txt. Cerrado por defecto a
# propósito: desplegar sin configurar nada deja el sitio protegido.
# Ojo: el <meta> se calcula al compilar, así que cambiar esta variable exige
# un despliegue nuevo, no basta con guardarla en Vercel.
SITIO_INDEXABLE=
